  "description": "MRGN class describes the classification of multidrug-resistant Gram-negative pathogens according to the RKI categorisation.",
  "purpose": "This profile describes the MRGN class.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "https://www.medizininformatik-initiative.de/fhir/core/modul-labor/StructureDefinition/ObservationLab",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation.extension:triggeredBy-r5",
        "path": "Observation.extension",
        "sliceName": "triggeredBy-r5",
        "short": "Only for follow-up diagnostics that were actually triggered. The clinical derivation of the MRGN classification is represented not here but via derivedFrom.",
        "min": 0,
        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://hl7.org/fhir/5.0/StructureDefinition/extension-Observation.triggeredBy"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Observation.extension:triggeredBy-r5.extension:observation",
        "path": "Observation.extension.extension",
        "sliceName": "observation",
        "short": "Triggering observation."
      },
      {
        "id": "Observation.extension:triggeredBy-r5.extension:type",
        "path": "Observation.extension.extension",
        "sliceName": "type",
        "short": "Describes how an investigation was triggered in the diagnostic context; in particular, the value “reflex” marks follow-up diagnostics triggered by the result of a preceding investigation."
      },
      {
        "id": "Observation.category",
        "path": "Observation.category",
        "min": 2
      },
      {
        "id": "Observation.category:mibi-category",
        "path": "Observation.category",
        "sliceName": "mibi-category",
        "short": "Microbiology category",
        "definition": "Category slice for microbiological laboratory investigations.",
        "min": 1,
        "max": "1",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "MB",
              "system": "http://terminology.hl7.org/CodeSystem/v2-0074"
            }
          ]
        },
        "mustSupport": true
      },
      {
        "id": "Observation.code",
        "path": "Observation.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "99780-9",
              "system": "http://loinc.org"
            }
          ]
        }
      },
      {
        "id": "Observation.value[x]",
        "path": "Observation.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ]
      },
      {
        "id": "Observation.value[x]:valueCodeableConcept",
        "path": "Observation.value[x]",
        "sliceName": "valueCodeableConcept",
        "short": "MRGN classification according to RKI. If the identified isolate was assessed on the basis of the susceptibility results and cannot be assigned to any MRGN class, 'Keine MRGN-Klasse' (no MRGN class) is used; this is to be distinguished from the negative result of a targeted pathogen detection.",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "required",
          "valueSet": "https://www.medizininformatik-initiative.de/fhir/modul-mikrobio/ValueSet/mii-vs-mikrobio-mrgn-klasse-loinc"
        }
      },
      {
        "id": "Observation.dataAbsentReason",
        "path": "Observation.dataAbsentReason",
        "binding": {
          "strength": "extensible",
          "valueSet": "https://www.medizininformatik-initiative.de/fhir/modul-mikrobio/ValueSet/mii-vs-mikrobio-data-absent-reason"
        }
      },
      {
        "id": "Observation.specimen",
        "path": "Observation.specimen",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://www.medizininformatik-initiative.de/fhir/modul-mikrobio/StructureDefinition/mii-pr-mikrobio-probe"
            ]
          }
        ]
      },
      {
        "id": "Observation.derivedFrom",
        "path": "Observation.derivedFrom",
        "short": "Investigations from which the classification was derived: the susceptibility results of the assessed substance groups, where applicable together with the pathogen identification. These investigations SHOULD be stated so that the basis of the classification is traceable. They may be omitted if the class is taken directly from an already classified laboratory report.",
        "mustSupport": true
      }
    ]

  "description": "Microbiological report for summarising and contextualising associated microbiological investigation results.",
  "purpose": "This profile describes the microbiological DiagnosticReport.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "DiagnosticReport",
  "baseDefinition": "https://www.medizininformatik-initiative.de/fhir/core/modul-labor/StructureDefinition/DiagnosticReportLab",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "DiagnosticReport.basedOn",
        "path": "DiagnosticReport.basedOn",
        "max": "1"
      },
      {
        "id": "DiagnosticReport.category",
        "path": "DiagnosticReport.category",
        "min": 2
      },
      {
        "id": "DiagnosticReport.category:mibi-category",
        "path": "DiagnosticReport.category",
        "sliceName": "mibi-category",
        "short": "Microbiology category",
        "definition": "Category slice for microbiological reports",
        "min": 1,
        "max": "1",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "MB",
              "system": "http://terminology.hl7.org/CodeSystem/v2-0074"
            }
          ]
        },
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.category:mibi-sub-category",
        "path": "DiagnosticReport.category",
        "sliceName": "mibi-sub-category",
        "short": "Microbiology category LOINC",
        "definition": "Category slice for the LOINC coding of microbiological reports. Multiple entries are permitted if the report covers several study types, e.g. bacteriological and mycological. If the report covers no nameable study types or is only to be classified generally, the subtype is omitted; the general classification is then made solely via category[mibi-category] with MB.",
        "min": 0,
        "max": "*",
        "mustSupport": true,
        "binding": {
          "strength": "required",
          "valueSet": "https://www.medizininformatik-initiative.de/fhir/modul-mikrobio/ValueSet/mii-vs-mikrobio-befundtyp-loinc"
        }
      },
      {
        "id": "DiagnosticReport.resultsInterpreter",
        "path": "DiagnosticReport.resultsInterpreter",
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.result",
        "path": "DiagnosticReport.result",
        "type": [
          {
            "code": "Reference",

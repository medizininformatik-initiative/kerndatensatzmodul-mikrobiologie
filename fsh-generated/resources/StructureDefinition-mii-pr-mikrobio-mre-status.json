        }
      },
      {
        "id": "Observation.specimen",
        "path": "Observation.specimen",
        "min": 1
      },
      {
        "id": "Observation.derivedFrom",
        "path": "Observation.derivedFrom",
        "short": "Befunde, aus denen der MRE-Status abgeleitet wurde: Erregeridentifikation, Empfindlichkeitsbefunde, Resistenzmechanismen/Determinanten und ggf. eine vorliegende MRGN-Klassifikation.",
        "min": 1,
        "mustSupport": true
      }
    ]
  }
